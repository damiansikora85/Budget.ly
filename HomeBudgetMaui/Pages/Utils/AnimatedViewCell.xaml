<?xml version="1.0" encoding="UTF-8" ?>
<Grid
    x:Class="HomeBudget.Pages.Utils.AnimatedViewCell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:HomeBudgetStandard.Components"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:local="clr-namespace:HomeBudgetMaui.Extensions"
    Padding="0,5"
    BackgroundColor="Transparent"
    ColumnDefinitions="50,*,*,50"
    RowDefinitions="*,2,*"
    RowSpacing="0"
    Margin="5,0"
    HeightRequest="50">

    <Label
            Grid.Column="1"
            Grid.ColumnSpan="2"
            FontSize="14"
            InputTransparent="True"
            LineBreakMode="TailTruncation"
            Text="{Binding Name}"
            TextColor="Black"
            VerticalTextAlignment="End" />
    <Label
            Grid.Column="2"
            FontSize="12"
            HorizontalOptions="End"
            HorizontalTextAlignment="End"
            LineBreakMode="NoWrap"
            Text="{Binding SpendPercentage, StringFormat='{0:P1}'}"
            VerticalTextAlignment="End" />

    <Label
            Grid.Row="2"
            Grid.Column="1"
            FontSize="12"
            InputTransparent="True"
            LineBreakMode="NoWrap"
            Text="{Binding SubcatReal.Value, Converter={StaticResource CurrencyValueConverter}}"
            VerticalTextAlignment="Start" />
    <Label
            Grid.Row="2"
            Grid.Column="2"
            FontSize="12"
            HorizontalOptions="End"
            HorizontalTextAlignment="End"
            InputTransparent="True"
            LineBreakMode="NoWrap"
            Text="{Binding SubcatPlan.Value, Converter={StaticResource CurrencyValueConverter}}"
            VerticalTextAlignment="Start" />

    <ProgressBar
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Progress="{Binding SpendPercentage}"
        local:ProgressBarExtensions.UseGradient="True"/>

    <Image
            Grid.RowSpan="3"
            Margin="0,6"
            InputTransparent="True"
            Source="{Binding Icon}" />
    <Image
            Grid.RowSpan="3"
            Grid.Column="3"
            Margin="5,5"
            BackgroundColor="Transparent"
            Source="add.png" />

</Grid>